{
  "name": "worcalc-native",
  "version": "1.1.8",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node native/prepare-assets.js",
    "build": "npm run build:calculator",
    "build:calculator": "npm run assets && vite build --config native/frontend/vite.config.js --mode calculator",
    "build:sketcher": "npm run assets && vite build --config native/frontend/vite.config.js --mode sketcher",
    "build:kill-tracker": "vite build --config native/frontend/vite.config.js --mode kill-tracker",
    "dev": "npm run assets && vite --config native/frontend/vite.config.js",
    "dev:calculator": "npm run assets && vite --config native/frontend/vite.config.js --mode calculator",
    "dev:sketcher": "npm run assets && vite --config native/frontend/vite.config.js --mode sketcher",
    "dev:kill-tracker": "vite --config native/frontend/vite.config.js --mode kill-tracker",
    "test": "node --test native/frontend/tests/*.test.js",
    "test:desktop": "tauri build --debug --no-bundle --config native/frontend/tests/desktop-flow.tauri.json --features sketcher -- --no-default-features && node native/frontend/tests/desktop-flow.mjs",
    "tauri": "tauri",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File native/build-desktop.ps1 -CreateShortcuts",
    "desktop:package": "powershell -NoProfile -ExecutionPolicy Bypass -File native/package-desktop.ps1",
    "icons": "tauri icon native/icon.json",
    "android:init": "tauri android init --ci",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File native/build-android.ps1"
  },
  "dependencies": { "@tauri-apps/api": "^2", "@tauri-apps/plugin-fs": "^2" },
  "devDependencies": { "@tauri-apps/cli": "^2", "vite": "^7" }
}
